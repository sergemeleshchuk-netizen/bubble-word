{
  "name": "bubble-level-tool",
  "private": true,
  "version": "1.32.0",
  "type": "module",
  "description": "Инструмент генерации уровней для word-association паззла",
  "scripts": {
    "test": "node --test 'tests/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "audit": "python3 scripts/audit_reference.py",
    "snapshot": "python3 scripts/export_snapshot.py",
    "snapshot:reference": "python3 scripts/export_reference_snapshot.py",
    "snapshot:lexicon": "python3 scripts/export_lexicon_snapshot.py",
    "calibrate": "python3 scripts/calibrate_difficulty.py --write",
    "block": "node scripts/generate_block.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx --yes surge web/dist bubble-level-tool.surge.sh",
    "build:site": "npm run build && rm -rf ../../site/tool && cp -R web/dist ../../site/tool",
    "deploy:site": "npm run build:site && cd ../.. && npx --yes surge ./site serge-mel.surge.sh",
    "deploy:commit": "bash scripts/deploy_commit.sh"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
