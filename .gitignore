# Тяжёлые референсы (видео целевой игры, выгрузки чужих ответов) не коммитим.
# Слеш в начале обязателен: правило `reference/` без него ловило ЛЮБУЮ папку
# с таким именем на любой глубине, включая site/assets/reference с кадрами
# для отчёта — их коммитить нужно.
/reference/

# Секреты
.env
.env.*

# Питон-окружение и тяжёлые результаты пайплайна слов
.venv/
level-generator/bubble_jam_pipeline/output/

# Системный мусор
.DS_Store
node_modules/
.pytest_cache/

# Служебные файлы SQLite: появляются от любого чтения базы в режиме WAL и
# коммитятся случайно. Сама база — отдельный вопрос, здесь только её хвосты.
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Архивы для передачи наружу собираются командой, в git не нужны
*.zip
